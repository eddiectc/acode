# Environment for the acode compose stack. Copy it to .env, which Compose loads
# automatically and .gitignore keeps out of git. Every default is a development
# value; see docs/container.md section 5.

# The project to edit, and the stack checkout. The launchers export both from
# their own environment, so set them in the shell for a launcher run; these
# entries apply to a bare `compose` invocation, where unset means $PWD.
#ACODE_WORKSPACE=/home/you/src/project
#ACODE_STACK_DIR=/home/you/src/acode

# A models.dev catalog ID that the upstream also accepts by name.
ACODE_MODEL=deepseek-v4.1-flash

# The gateway's master key, which acode presents as ACODE_PROVIDER_TOKEN. It is
# a spending credential for the pass-through route: cap spending at the provider.
LITELLM_MASTER_KEY=sk-acode-local

# The real provider key. Only LiteLLM sees it.
OPENCODE_API_KEY=

# SearXNG's server.secret_key, and the token acode sends to Crawl4AI.
SEARXNG_SECRET=acode-local-searxng
CRAWL4AI_API_TOKEN=acode-local-crawl4ai
#SEARXNG_BASE_URL=http://localhost:8889/  # defaults to http://localhost:<SEARXNG_PORT>/

# Each port is both the container port and the 127.0.0.1 publish, so it moves
# the listener, the healthcheck, and acode's URLs together.
SEARXNG_PORT=8889
LITELLM_PORT=4000
CRAWL4AI_PORT=11235

# The released image the stack image copies acode out of, and the image user.
ACODE_IMAGE=ghcr.io/eddiectc/acode:latest
ACODE_UID=1000
ACODE_GID=1000

# Credentials the agent itself uses belong in compose.local.yaml, not here:
# run_command children get an environment allowlist, so nothing in this file
# reaches them. docs/container.md section 5.
