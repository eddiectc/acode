# Environment for the acode compose stack.
#
#   cp .env.example .env
#
# Compose loads .env from this directory automatically, and .gitignore keeps it
# out of the repository. Every default here is a development value: the stack
# publishes its ports on 127.0.0.1 only, but a real credential still belongs in
# .env and never in an image or a committed file.

# The project to edit. Unset is the normal case: the workspace is the directory
# Compose runs from ($PWD), so `cd` to the project and run the stack there.
# Set it only to pin a fixed path, for example when two instances run at once.
#ACODE_WORKSPACE=/home/you/src/project

# The checkout that holds this stack, for podman-compose run from another
# directory (it resolves relative mounts against the working directory).
# Docker Compose resolves them against compose.yaml and ignores this.
#ACODE_STACK_DIR=/home/you/src/acode

# A models.dev catalog ID that the upstream also accepts by name. The gateway
# forwards it verbatim, so a name only the catalog knows fails upstream and a
# name only the gateway knows fails in acode.
ACODE_MODEL=deepseek-v4.1-flash

# The gateway's master key. acode presents it as ACODE_PROVIDER_TOKEN and the
# pass-through route requires it (auth: true). No database is configured, so
# this is the only key that exists — and it is a spending credential for the
# pass-through route: whoever holds it can call the upstream with the real
# provider key. Treat it that way, and cap spending at the provider.
LITELLM_MASTER_KEY=sk-acode-local

# The real provider key, read by compose/litellm/config.yaml as the
# pass-through Authorization header. Only LiteLLM sees it.
OPENCODE_API_KEY=

# SearXNG server.secret_key.
SEARXNG_SECRET=acode-local-searxng

# Crawl4AI API token. acode sends it as ACODE_WEB_FETCH_KEY.
CRAWL4AI_API_TOKEN=acode-local-crawl4ai

# Service ports. Each value is both the container port and the 127.0.0.1
# publish, so it moves the listener, the publish, the healthcheck, and acode's
# URLs together: acode talks to LiteLLM at http://litellm:$LITELLM_PORT and
# Crawl4AI at http://crawl4ai:$CRAWL4AI_PORT, and to SearXNG on loopback at
# 127.0.0.1:$SEARXNG_PORT. Change them to run a second stack on the same host
# (`docker compose -p acode-2 ...`) or when a port is already taken.
#
# SearXNG defaults to 8889 rather than its usual 8080: acode shares its network
# namespace, and 8080 is the commonest dev-server port, so leaving it free means
# a server the agent starts on 8080 does not collide with the search backend.
SEARXNG_PORT=8889
LITELLM_PORT=4000
CRAWL4AI_PORT=11235

#SEARXNG_BASE_URL=http://localhost:8889/  # defaults to http://localhost:<SEARXNG_PORT>/

# The released image the stack image copies acode out of, and the UID/GID of
# the image user. Docker users whose host UID or GID is not 1000 set these;
# rootless Podman keeps the defaults and maps the caller with keep-id.
ACODE_IMAGE=ghcr.io/eddiectc/acode:latest
ACODE_UID=1000
ACODE_GID=1000
