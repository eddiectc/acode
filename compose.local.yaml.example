# Per-machine overrides for the acode compose stack, and the file the agent's
# own credentials and commit identity belong in. It is not in git; this example
# is.
#
#   cp compose.local.yaml.example compose.local.yaml
#
# The launcher scripts pass it last when it exists, so it wins over
# compose.yaml and compose.podman.yaml; docs/container.md section 5.
#
# Keep to keys Docker Compose and podman-compose both honour. The mounts below
# are plain read-only binds rather than Compose `secrets:` entries, because the
# two engines differ in how they implement `secrets:` and a bind does not.

services:
  acode:
    # Build the stack image from Dockerfile.gh instead of compose/Dockerfile, so
    # the launchers' image carries gh. The result is the published image plus
    # gh: the Go toolchain of compose/Dockerfile is gone, so uncomment this only
    # for a workspace that does not need it. ACODE_IMAGE still selects the acode
    # release, because compose.yaml passes it as a build argument and it is
    # Dockerfile.gh's FROM (container.md section 6).
    #
    # build:
    #   dockerfile: Dockerfile.gh
    #
    # An explicit empty list, not a bare `volumes:`, which YAML reads as null:
    # podman-compose's container_to_args iterates `cnt.get("volumes", [])`, and
    # `for v in None` is a TypeError. Uncomment a block below by adding it under
    # this key.
    volumes: []
      # Every mount here is opt-in: uncomment the ones this agent needs and
      # leave the rest out. A credential it does not need only gives an
      # injected instruction something to use, and nothing below is required
      # for the stack to start -- docs/container.md section 5.
      #
      # Without the gitconfig block, `git commit` inside the container fails
      # with "Committer identity unknown" until the workspace or a repo
      # carries its own user.name/user.email. Without the .ssh block, a push
      # over an ssh remote fails on host-key verification. Both are intended
      # defaults for an agent that only edits code.
      #
      # GitHub authentication is the gh block: a login made on the host, as a
      # bot account, mounted read-only. It needs an image that carries gh, which
      # the published image does not. Dockerfile.gh at the repository root is
      # that image; build it directly for a `podman run` (container.md section
      # 2), or let the stack build it by uncommenting the block below, which
      # also drops the Go toolchain (container.md section 6):
      #
      #   docker build -f Dockerfile.gh -t acode:gh .
      #
      #   install -d -m 0700 ~/.config/acode/gh
      #   read -rs GH_PAT
      #   printf '%s' "$GH_PAT" | env -u GH_TOKEN -u GITHUB_TOKEN \
      #     GH_CONFIG_DIR="$HOME/.config/acode/gh" \
      #     gh auth login --with-token --insecure-storage
      #   unset GH_PAT
      #   GH_CONFIG_DIR="$HOME/.config/acode/gh" gh auth status
      #
      # --insecure-storage is what writes the token into hosts.yml; the default
      # secure storage is the host keyring, which no bind can carry. The target
      # is fixed rather than chosen: gh reads GH_CONFIG_DIR, then
      # XDG_CONFIG_HOME/gh, then HOME/.config/gh, and a run_command child gets
      # neither of the first two (PATH, LANG, LC_ALL, TERM, HOME, TMPDIR).
      #
      # - type: bind
      #   source: ${HOME:?HOME is not set}/.config/acode/gh
      #   target: /home/acode/.config/gh
      #   read_only: true
      #   bind:
      #     selinux: Z
      #
      # Commit identity. GIT_AUTHOR_NAME and friends in .env would not arrive:
      # run_command children get an environment allowlist (PATH, LANG, LC_ALL,
      # TERM, HOME, TMPDIR), and a tool call is what runs `git`. HOME does arrive
      # and `~/.gitconfig` is where git looks, so the identity is a file.
      #
      # A separate file, not your own ~/.gitconfig: that one would attribute what
      # the agent commits to you. Mounted read-only, so the agent cannot rewrite
      # the identity it commits under. The email has to belong to the bot account
      # or GitHub shows the commit unattributed; the `ID+login@users.noreply...`
      # form always does, and hides a real address.
      #
      #   printf '[user]\n\tname = acode-bot\n\temail = 12345+acode-bot@users.noreply.github.com\n' \
      #     > ~/.config/acode/gitconfig
      #
      # Read-only, so `git config --global` fails inside; that is intended.
      # This is also where a credential helper for https pushes belongs, when
      # the image carries gh:
      #
      #   [credential "https://github.com"]
      #       helper =
      #       helper = !gh auth git-credential
      #
      # - type: bind
      #   source: ${HOME:?HOME is not set}/.config/acode/gitconfig
      #   target: /home/acode/.gitconfig
      #   read_only: true
      #   bind:
      #     selinux: Z
      #
      # SSH: the key for pushing, and known_hosts so ssh does not have to learn
      # github.com. One directory bind, not a bind per file, because known_hosts
      # has to sit beside the key at the path ssh reads by default
      # (/home/acode/.ssh/known_hosts, confirmed with `ssh -G github.com`), and
      # a single bind keeps the two together.
      #
      #   install -d -m 0700 ~/.config/acode/.ssh
      #   cp ~/.ssh/id_ed25519 ~/.config/acode/.ssh/   # a copy, not your only key
      #   curl -sS https://api.github.com/meta \
      #     | python3 -c 'import json,sys;[print("github.com",k) for k in json.load(sys.stdin)["ssh_keys"]]' \
      #     > ~/.config/acode/.ssh/known_hosts
      #
      # Take the host keys from GitHub's published list over HTTPS, not from
      # ssh-keyscan, which trusts whichever host answers first and records it.
      #
      # Read-only is the point. ssh writes to known_hosts only while learning an
      # unseen host, and pre-populating removes that write, so a writable mount
      # buys nothing and would let an injected instruction re-pin github.com to
      # a key of its choosing -- the exact attack the file exists to prevent.
      # One line per host you push to; an unknown host then fails loudly.
      #
      # - type: bind
      #   source: ${HOME:?HOME is not set}/.config/acode/.ssh
      #   target: /home/acode/.ssh
      #   read_only: true
      #   bind:
      #     selinux: Z
