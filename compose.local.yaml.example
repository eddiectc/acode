# Per-machine overrides for the acode stack. Not in git:
#
#   cp compose.local.yaml.example compose.local.yaml
#
# The launchers pass it last, so it wins over the tracked files. The credentials
# of docs/container.md section 5 are mounted by compose.yaml itself, so nothing
# here is needed to run the stack.

services:
  acode:
    # The stack builds compose/Dockerfile: a Go toolchain, the released binary,
    # gh, and the pinned check tools. A workspace in another language copies
    # that file, changes the base, and points this at the copy. The tracked
    # image: has to be replaced too, or the build lands on the stack's own tag.
    #
    # build:
    #   context: ${ACODE_STACK_DIR:-.}
    #   dockerfile: Dockerfile.toolchain
    # image: localhost/acode-stack:toolchain
    #
    # An explicit empty list, not a bare `volumes:`, which YAML reads as null:
    # podman-compose's container_to_args iterates `cnt.get("volumes", [])`, and
    # `for v in None` is a TypeError.
    volumes: []
