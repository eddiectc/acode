#!/usr/bin/env bash
# Run acode in the compose stack with Docker Compose, editing the current
# directory. Each invocation gets its own one-off container under a random name,
# so several instances can run at once; docs/container.md section 1.
#
#   cd ~/src/project
#   ~/acode/scripts/acode-docker                        # TUI on ~/src/project
#   ~/acode/scripts/acode-docker -model <id> -task "..."  # arguments go to acode
#   ACODE_TTY=0 ~/acode/scripts/acode-docker < task.txt   # no TTY, for piped input
#
# ACODE_WORKSPACE pins a project other than $PWD. The stack runs the published
# image and builds nothing; a compose.local.yaml that adds `build:` with your own
# Dockerfile adds a toolchain, and ACODE_BUILD=1 then forces that rebuild.
# A compose.local.yaml in the stack checkout is passed last, so a machine-local
# override -- a credential bind, a toolchain image, another ACODE_IMAGE -- wins
# and stays out of git; docs/container.md sections 5 and 6.
set -eu

STACK_DIR="${ACODE_STACK_DIR:-$(cd -- "$(dirname -- "$0")/.." && pwd -P)}"
WORKSPACE="${ACODE_WORKSPACE:-$PWD}"

[ -f "$STACK_DIR/compose.yaml" ] || {
  echo "acode-docker: no compose.yaml in $STACK_DIR; set ACODE_STACK_DIR" >&2
  exit 1
}
command -v docker >/dev/null 2>&1 || {
  echo "acode-docker: docker not found in PATH" >&2
  exit 1
}

# Absolute, because the mount repeats the host path inside the container and a
# relative source is not usable there. Existing, because a typo would otherwise
# let the engine create an empty root-owned directory for the bind.
case "$WORKSPACE" in
  /*) ;;
  *) echo "acode-docker: workspace must be an absolute path: $WORKSPACE" >&2; exit 2 ;;
esac
[ -d "$WORKSPACE" ] || {
  echo "acode-docker: workspace is not a directory: $WORKSPACE" >&2
  exit 2
}

# Compose interpolates the bind and working_dir before the container exists, so
# `run -e` cannot carry these; they have to be in this process environment.
export ACODE_WORKSPACE="$WORKSPACE"
export ACODE_STACK_DIR="$STACK_DIR"

# A per-machine override that is not in git: a credential bind, another
# ACODE_IMAGE, extra volumes. Compose merges later files over earlier ones, so
# it goes last and wins; docs/container.md section 5.
FILES=(-f "$STACK_DIR/compose.yaml")
if [ -f "$STACK_DIR/compose.local.yaml" ]; then
  FILES+=(-f "$STACK_DIR/compose.local.yaml")
fi

# The merged config decides what the launcher used to assume: which image the
# acode service runs, and whether anything is built at all. The default stack
# builds nothing, so a first run needs no build step; a compose.local.yaml that
# adds a Dockerfile supplies `build:` and its own tag (docs/container.md
# section 6). Reading both from the config keeps the tag in one place instead of
# a second copy of the default here, which is also why ACODE_STACK_IMAGE is gone.
CONFIG="$(docker compose "${FILES[@]}" config)" || {
  echo "acode-docker: docker compose could not resolve the merged config" >&2
  exit 1
}
PROJECT="$(printf '%s\n' "$CONFIG" | awk '/^name: /{print $2; exit}')"
# Two-space service keys, four-space keys inside one; awk has no YAML parser, so
# this tracks the acode block by indentation alone.
ACODE_BLOCK="$(printf '%s\n' "$CONFIG" | awk '
  /^  acode:[[:space:]]*$/ { inside = 1; next }
  inside && /^  [^[:space:]]/ { inside = 0 }
  inside { print }
')"
IMAGE="$(printf '%s\n' "$ACODE_BLOCK" |
  awk '/^    image:/{ sub(/^    image:[[:space:]]*/, ""); print; exit }' |
  tr -d "\"'")"
BUILD="$(printf '%s\n' "$ACODE_BLOCK" | awk '/^    build:/{ print "yes"; exit }')"

# A bind whose source is a missing *file* is created as a directory, because the
# Compose spec's create_host_path defaults to true and podman-compose's
# assert_volume calls os.makedirs for the same case. A directory mounted at
# /home/acode/.gitconfig makes every git call inside the container fail with
# "unable to access '/home/acode/.gitconfig': Is a directory" -- the agent looks
# broken rather than merely unconfigured. Seeding an empty file keeps git working
# and leaves user.name unset, so `git commit` is the only thing that fails, which
# is what the documentation describes. The parent directories are made as the
# invoking user, not the engine, which would create them root-owned and leave a
# later real login unable to write them.
GITCONFIG="$HOME/.config/acode/gitconfig"
case "$CONFIG" in
  *"$GITCONFIG"*)
    if [ ! -e "$GITCONFIG" ]; then
      mkdir -p "${GITCONFIG%/*}"
      chmod 0700 "${GITCONFIG%/*}"
      : > "$GITCONFIG"
      chmod 0644 "$GITCONFIG"
      echo "acode-docker: seeded an empty $GITCONFIG; add a [user] section for the agent's commits" >&2
    fi
    ;;
esac

# 32 random bits keep concurrent instances apart, and the name is what a later
# `docker logs`, `docker stop`, or `docker exec` needs to address one of them.
NAME="acode-$(od -An -N4 -tx4 /dev/urandom | tr -d ' \n')"

RUN=(run --rm --name "$NAME")
if [ "${ACODE_TTY:-1}" = "0" ]; then
  RUN+=(-T)
fi
# Build only when the merged config has something to build. `--build` against a
# service without a build is an error in one engine and a silent no-op in the
# other, so the config decides rather than a guess at the image tag.
if [ -n "$BUILD" ]; then
  if [ "${ACODE_BUILD:-0}" = "1" ] || [ -z "$IMAGE" ] ||
    ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    RUN+=(--build)
  fi
elif [ "${ACODE_BUILD:-0}" = "1" ]; then
  echo "acode-docker: acode has no build in the merged config; nothing to rebuild" >&2
fi

echo "acode-docker: $NAME on $WORKSPACE" >&2
exec docker compose "${FILES[@]}" "${RUN[@]}" acode "$@"
